pragma circom 2.1.6;

// GENERATED by scripts/gen_fused_circuit.py -- do not edit by hand.
//
// Fused composite step: gain_k2 -> atten_m1 -> dist_d100
//
// Proves edit = f3(f2(f1(orig))) over every sample
// in the batch, decompressing the input once and recompressing the result
// once. The intermediate streams are never packed, never hashed and get
// no commitment, so nothing can be proven about them later; that is the
// trade for the saving. See docs/edit_chains.md, "Fusion".
//
// Each stage's output is consumed as a digit that no Decompressor
// range-checks, so the composition relies on every stage bounding its own
// output to [0, 2^bit_depth - 1]. The generator enforces that for every
// interior stage.
//
// Rounding is applied per stage, not fused: floor(f2(floor(f1(x)))) is not
// floor(f2(f1(x))). The Rust reference must apply the stages in sequence
// for the same reason.

include "hasher.circom";
include "hasher_sponge.circom";
include "decompressor.circom";
include "edits/gain/gain_step.circom";
include "edits/attenuation/atten_step.circom";
include "edits/distortion/dist_step.circom";

// One digit through every stage, in order.
template FusedSample10_8() {
    signal input orig;
    signal output edit;

    var GAIN_RAW_MAX_s0 = 2 * ((1 << 8) - 1);
    var GAIN_BITS_s0 = 0;
    var GAIN_PROBE_s0 = GAIN_RAW_MAX_s0;
    while (GAIN_PROBE_s0 > 0) {
        GAIN_BITS_s0++;
        GAIN_PROBE_s0 = GAIN_PROBE_s0 >> 1;
    }
    var DIST_HALF_s2 = 1 << (8 - 1);
    var DIST_SCALE_s2 = 1 << 16;
    var DIST_VMAX_s2 = 3 * DIST_SCALE_s2 * DIST_HALF_s2;
    var DIST_VBITS_s2 = 0;
    var DIST_PROBE_s2 = DIST_VMAX_s2;
    while (DIST_PROBE_s2 > 0) {
        DIST_VBITS_s2++;
        DIST_PROBE_s2 = DIST_PROBE_s2 >> 1;
    }

    // stage 1: gain_k2
    component g_s0 = ClampedGain(8, 2, GAIN_BITS_s0);
    g_s0.orig <== orig;

    // stage 2: atten_m1
    component a_s1 = AttenuatedGain(8, 1);
    a_s1.orig <== g_s0.edit;

    // stage 3: dist_d100
    component d_s2 = DistortSample(8, 65536, DIST_VBITS_s2);
    d_s2.orig <== a_s1.edit;

    edit <== d_s2.edit;
}

template FusedBatchCheck(batch_size, bit_depth) {
    // Integer division (\), not field division: at bit_depth=24
    // 232/24 is not exact, and `/` would compute a modular inverse.
    var comp_size = (256 - bit_depth) \ bit_depth;

    signal input orig[batch_size];
    signal input edit[batch_size];

    component decompressor_orig[batch_size];
    component fused[batch_size][comp_size];
    component recompressor[batch_size];
    signal expected[batch_size][comp_size];

    for (var j = 0; j < batch_size; j++) {
        // The input is decompressed once for the whole composite,
        // which is the saving a sequential chain does not get: there
        // each stage pays its own Num2Bits.
        decompressor_orig[j] = Decompressor(bit_depth);
        decompressor_orig[j].in <== orig[j];

        for (var s = 0; s < comp_size; s++) {
            fused[j][s] = FusedSample10_8();
            fused[j][s].orig <== decompressor_orig[j].out[s];
            expected[j][s] <== fused[j][s].edit;
        }

        // Safe to repack: the last stage bounds every digit to
        // [0, 2^bit_depth - 1].
        recompressor[j] = Recompressor(bit_depth);
        recompressor[j].in <== expected[j];

        edit[j] === recompressor[j].out;
    }
}

template Fused(batch_size, bit_depth) {
    // (prev_orig_hash, prev_edit_hash)
    signal input step_in[2];
    signal output step_out[2];

    signal input orig[batch_size];
    signal input edit[batch_size];

    // Only the input and the final output are committed to.
    component orig_batch_hasher = SpongeBatchHasher(batch_size, 4);
    component edit_batch_hasher = SpongeBatchHasher(batch_size, 4);
    component orig_hasher = Hasher(2);
    component edit_hasher = Hasher(2);

    orig_batch_hasher.batch <== orig;
    orig_hasher.values[0] <== step_in[0];
    orig_hasher.values[1] <== orig_batch_hasher.hash;
    step_out[0] <== orig_hasher.hash;

    edit_batch_hasher.batch <== edit;
    edit_hasher.values[0] <== step_in[1];
    edit_hasher.values[1] <== edit_batch_hasher.hash;
    step_out[1] <== edit_hasher.hash;

    component check = FusedBatchCheck(batch_size, bit_depth);
    check.orig <== orig;
    check.edit <== edit;
}

component main { public [step_in] } = Fused(10, 8);
